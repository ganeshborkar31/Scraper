APP_ENV=development
APP_PORT=8001
APP_SECRET_KEY=replace-with-a-long-random-local-secret
DATABASE_URL=sqlite:///./business.db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-for-local-development
PUBLIC_CONTACT_EMAIL=operator@example.com
# Overpass live connector is not enabled until endpoint policy/configuration is reviewed.
OSM_OVERPASS_URL=
OSM_USER_AGENT=BusinessDataDiscovery/0.1 (contact: operator@example.com)
